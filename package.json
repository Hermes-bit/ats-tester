{
  "name": "ats-tester",
  "version": "1.0.0",
  "private": true,
  "description": "Simulateur d'ATS : teste ton CV et ta lettre de motivation face à une offre d'emploi.",
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "jest": "30.5.2"
  }
}
